# Network: testnet | mainnet
NEAR_NETWORK=testnet
NEAR_RPC=https://rpc.testnet.fastnear.com
# The VEIL contract this relayer serves (and nothing else).
VEIL_CONTRACT=veil.testnet
# The relayer's own account and full-access key. Keep it funded; never commit the key.
RELAYER_ACCOUNT=veil-relayer.testnet
RELAYER_PRIVATE_KEY=ed25519:...
# NEAR attached to each OutLayer run (unused part is refunded to the relayer).
ENGINE_DEPOSIT_NEAR=0.05
# NEAR sent to create a new player's implicit account.
ONBOARD_NEAR=0.01
PORT=8790
# Comma-separated origins allowed to call the relayer (the web app).
ALLOWED_ORIGINS=http://localhost:5173
