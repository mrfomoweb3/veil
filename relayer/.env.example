# Network: testnet | mainnet
NEAR_NETWORK=testnet
# One RPC, or several comma-separated (fails over when one rate-limits or is down).
NEAR_RPC=https://test.rpc.fastnear.com,https://rpc.testnet.fastnear.com,https://rpc.testnet.near.org
# The VEIL contract this relayer serves (and nothing else).
VEIL_CONTRACT=veil.testnet
# The relayer's own account. Keep it funded. Its key is read from
# ~/.near-credentials/<network>/<account>.json (near-cli's legacy keychain) unless
# RELAYER_PRIVATE_KEY is set (e.g. on a server). Never commit the key.
RELAYER_ACCOUNT=veil-relayer.testnet
# RELAYER_PRIVATE_KEY=ed25519:...
# NEAR attached to each OutLayer run (unused part is refunded to the relayer).
ENGINE_DEPOSIT_NEAR=0.05
# NEAR sent to create a new player's implicit account.
ONBOARD_NEAR=0.01
# How often the cranker looks for due turns. Free RPCs rate-limit; keep it modest.
CRANK_EVERY_MS=5000
PORT=8790
# Comma-separated origins allowed to call the relayer (the web app).
ALLOWED_ORIGINS=http://localhost:5173
